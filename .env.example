# Supabase (obrigatório)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Branding local do dashboard
NEXT_PUBLIC_APP_NAME=Instagram Dashboard
NEXT_PUBLIC_BRAND_NAME=Meu Instagram
NEXT_PUBLIC_BRAND_HANDLE=@seu_perfil
NEXT_PUBLIC_BRAND_TAGLINE=Content Manager
NEXT_PUBLIC_BRAND_USER_ROLE=Admin

# Instagram Graph API via Facebook Login / Meta App
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v19.0

# Compatibilidade com setups antigos. Use META_APP_ID/META_APP_SECRET em novos ambientes.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Metricool
METRICOOL_API_KEY=

# URL pública do app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
